{
  "crons": [
    { "path": "/api/cron/publish", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/interview", "schedule": "0 * * * *" },
    { "path": "/api/cron/daily", "schedule": "0 1 * * *" },
    { "path": "/api/cron/monitor", "schedule": "0 22 * * *" },
    { "path": "/api/cron/monthly", "schedule": "0 20 1 * *" }
